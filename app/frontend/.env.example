# URL base del sitio para SEO (canonical, Open Graph, sitemap.xml, robots.txt y JSON-LD).
# Copia este archivo a .env.local (no se commitea) o definela en el entorno de producción.
# En build con NODE_ENV=production el build FALLA si no está definida o apunta a localhost.
# En desarrollo sin definir se usa http://localhost:5173 y solo se genera un aviso.
VITE_SITE_URL=