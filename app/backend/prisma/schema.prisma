generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id    String @id @default(uuid())
  name  String @unique
  users User[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Session {
  id        String    @id
  data      String    @db.Text
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@map("sessions")
}

model Company {
  id             String           @id @default(uuid())
  name           String
  nit            String?
  description    String?
  mission        String?
  vision         String?
  values         Json?
  qualityPolicy  String?
  phone          String?
  whatsappNumber String?
  serviceCities  String[]
  email          String?
  address        String?
  schedules      String?
  services       Service[]
  reviews        Review[]
  gallery        GalleryImage[]
  messages       ContactMessage[]
  jobs           JobApplication[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id        String       @id @default(uuid())
  author    String
  content   String
  rating    Int
  status    ReviewStatus @default(PENDING)
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  @@index([read])
}

enum JobApplicationStatus {
  NEW
  REVIEWED
}

model JobApplication {
  id                    String               @id @default(uuid())
  name                  String
  position              String
  email                 String
  phone                 String
  message               String?
  status                JobApplicationStatus @default(NEW)
  read                  Boolean              @default(false)
  originalFileName      String
  mimeType              String
  fileSize              Int
  fileData              Bytes
  dataConsentAcceptedAt DateTime             @default(now())
  companyId             String
  company               Company              @relation(fields: [companyId], references: [id])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([status])
  @@map("job_applications")
}

model GalleryImage {
  id        String   @id @default(uuid())
  url       String
  alt       String?
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
}