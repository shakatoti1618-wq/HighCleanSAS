# Variables de entorno del backend en PRODUCCIÓN.
# Copia este archivo a .env o rellena las variables en el panel de Render (Blueprint).
# No contiene valores secretos: los secretos se ponen a mano en el panel (sync: false en render.yaml).
NODE_ENV=production
PORT=3000
# En producción NUNCA *, debe ser la URL exacta del frontend. Sin esto el backend NO ARRANCA.
CORS_ORIGIN=https://highcleansas.com
# Cadena pooled de Neon (PgBouncer), con sslmode=require. SECRETO.
DATABASE_URL=
# Secreto de firma de la cookie (>= 32 caracteres). SECRETO.
SESSION_SECRET=
# Credenciales del administrador reales (no las de desarrollo). SECRETOS.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# API key de Resend (dominio highcleansas.com ya verificado). SECRETO.
RESEND_API_KEY=
# Remitente verificado en Resend. El guard de producción impide onboarding@resend.dev.
EMAIL_FROM=notificaciones@highcleansas.com
# Correo que recibe cotizaciones (reenvía vía Cloudflare Email Routing a la casilla real).
NOTIFY_EMAIL_CONTACT=
# Correo que recibe hojas de vida.
NOTIFY_EMAIL_JOBS=