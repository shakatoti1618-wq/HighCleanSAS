# Variables de entorno del backend
# Copia este archivo a .env y ajusta los valores.
NODE_ENV=development
PORT=3000
# Orígenes permitidos para CORS y validación CSRF (Origin). En desarrollo puedes usar *,
# pero en PRODUCCIÓN debe ser la URL exacta del frontend (lista separada por comas, sin *):
# el backend NO ARRANCA si en producción CORS_ORIGIN=* (deshabilitaría la protección CSRF);
# si se fija una lista, cualquier mutación con un Origin diferente recibe 403.
CORS_ORIGIN=*
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/highclean?schema=public"
# Secreto de firma de la cookie de sesión (mínimo 32 caracteres; NUNCA el valor de desarrollo en producción).
SESSION_SECRET=genera-una-cadena-larga-y-aleatoria-de-32-caracteres-o-mas
# Credenciales del usuario administrador creado por npm run db:seed (únicamente para siembra).
ADMIN_EMAIL=admin@highclean.example
ADMIN_PASSWORD=cambia-esta-contrasena-fuerte
# Notificaciones por correo (Resend). En dev sin API key no se envían correos.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# Correo que recibe las cotizaciones/mensajes del formulario de contacto.
# NOTIFY_EMAIL_CONTACT=correo-contacto@highclean.example
# Correo que recibe las hojas de vida (trabaja con nosotros). PENDIENTE: reemplazar con
# el correo nuevo que se creará solo para esto.
# NOTIFY_EMAIL_JOBS=correo-hv@highclean.example